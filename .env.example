# Copy to `.env` and edit. Never commit your real .env.

# --- Sync your progress and the app itself through git ---
# Defaults work when you run the app from inside the repo, so this is optional.

# The repository folder on this machine (default: the project root).
# SYNC_REPO_DIR=D:/DSA_Thinking

# Where the database lives inside the repo.
SYNC_FILE=data/store.json
SYNC_BRANCH=main
SYNC_REMOTE=origin

# What counts as "the app" and gets committed alongside the database.
# SYNC_APP_PATHS=src server server.mjs index.html package.json package-lock.json vite.config.ts tsconfig.json .env.example

# Port for `npm start` (the built app + sync API).
PORT=5174
